# Supabase proje ayarları (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key YALNIZCA sunucu tarafında kullanılır, asla client'a sızdırmayın
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sitenin canlı adresi (sitemap, JSON-LD ve canonical linkler için)
NEXT_PUBLIC_SITE_URL=https://atalyahukuk.com

# Bakım modu normalde /admin/ayarlar panelinden veritabanı üzerinden
# yönetilir (deploy gerekmez). Bu değişken yalnızca acil durum "hard kill
# switch" olarak vardır — "true" yapılırsa panel ayarına bakılmaksızın
# bakım modu zorla açılır. Normal kullanımda boş/false bırakın.
MAINTENANCE_MODE=false
# Bakım modu açıkken siteyi önizlemek için opsiyonel gizli anahtar.
# Ayarlarsanız https://siteniz.com/?bypass=BURAYA_ANAHTAR ile bakım
# sayfasını atlayabilirsiniz (24 saat boyunca hatırlanır).
MAINTENANCE_BYPASS_TOKEN=

# Google Analytics 4 ölçüm kimliği (G-XXXXXXXXXX). Boş bırakılırsa
# Analytics hiç yüklenmez. Ziyaretçi çerez izni verirse devreye girer.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Anasayfadaki müvekkil yorumları bölümü için gerçek Google yorumlarını
# çeker (yalnızca 5 yıldız, en yeniden eskiye). İkisi de boşsa bölüm hiç
# gösterilmez. Google Cloud Console'da "Places API (New)" aktif bir API
# anahtarı ve işletmenizin Place ID'si gerekir.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# İletişim formu gönderildiğinde info@atalyahukuk.com adresine bildirim
# maili atmak için kullanılan SMTP bilgileri (Natro cPanel mail kutusu).
# cPanel → E-posta Hesapları → "Bağlantı Cihazları / Yapılandır" kısmından
# görebilirsiniz; genelde host "mail.atalyahukuk.com", port 465 (SSL) olur.
SMTP_HOST=mail.atalyahukuk.com
SMTP_PORT=465
# 465 (SSL) için "true", 587 (STARTTLS) için "false" yapın.
SMTP_SECURE=true
SMTP_USER=info@atalyahukuk.com
SMTP_PASSWORD=your-mailbox-password
# Bildirimin gideceği adres — boş bırakılırsa info@atalyahukuk.com kullanılır.
CONTACT_NOTIFICATION_EMAIL=info@atalyahukuk.com
